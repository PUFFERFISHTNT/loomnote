{
  "name": "loomnote",
  "version": "0.1.0",
  "private": true,
  "description": "织记 LoomNote — AI 原生智能笔记+复习+知识库桌面应用",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @loomnote/desktop dev"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "vitest": "^3.2.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
