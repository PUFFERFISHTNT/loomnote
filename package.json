{
  "name": "loomnote",
  "version": "0.2.0",
  "private": true,
  "description": "LoomNote — turn a lecture into a living note. Local-first study companion built on the DeepSeek Harness agent runtime.",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @loomnote/desktop dev",
    "harness:smoke": "node --experimental-strip-types scripts/harness-smoke.ts"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "vitest": "^3.2.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "better-sqlite3",
      "electron",
      "esbuild",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  }
}
